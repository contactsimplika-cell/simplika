/* ---------- Agenda Google (OAuth2, lecture seule) ----------
   Le jeton est gardé en sessionStorage (propre à cet onglet, jamais transmis à un
   serveur, effacé à la fermeture de l'onglet) pour éviter de redemander la connexion
   à chaque rafraîchissement de page. Il expire naturellement au bout d'environ 1h,
   comme le fait Google de toute façon — pas de prolongation artificielle. */
function saveGoogleToken(kind, accessToken, expiresInSeconds){
  const expiresAt = Date.now() + (expiresInSeconds || 3600) * 1000 - 60000; // marge de sécurité de 60s
  sessionStorage.setItem('simplikaGoogleToken_'+kind, JSON.stringify({ token: accessToken, expiresAt }));
}
function getValidGoogleToken(kind){
  try{
    const raw = sessionStorage.getItem('simplikaGoogleToken_'+kind);
    if(!raw) return null;
    const { token, expiresAt } = JSON.parse(raw);
    if(Date.now() >= expiresAt){ sessionStorage.removeItem('simplikaGoogleToken_'+kind); return null; }
    return token;
  }catch(e){ return null; }
}

document.getElementById('btnConnectAgenda').addEventListener('click', ()=>{
  if(!window.google || GOOGLE_CLIENT_ID.indexOf("COLLER_ICI") === 0){
    alert("La connexion à l'agenda n'est pas encore configurée (identifiant Google manquant).");
    return;
  }
  const tokenClient = google.accounts.oauth2.initTokenClient({
    client_id: GOOGLE_CLIENT_ID,
    scope: 'https://www.googleapis.com/auth/calendar.readonly',
    callback: async (resp)=>{
      if(resp.error){ alert("Connexion refusée."); return; }
      saveGoogleToken('calendar', resp.access_token, resp.expires_in);
      await afficherAgenda(resp.access_token);
    }
  });
  tokenClient.requestAccessToken();
});

async function afficherAgenda(token){
  const panel = document.getElementById('agendaPanel');
  panel.innerHTML = '<p class="hint">Chargement des événements...</p>';
  try{
    const timeMin = new Date().toISOString();
    const url = 'https://www.googleapis.com/calendar/v3/calendars/primary/events?timeMin='+encodeURIComponent(timeMin)+'&maxResults=10&orderBy=startTime&singleEvents=true';
    const resp = await fetch(url, { headers: { Authorization: 'Bearer '+token } });
    const data = await resp.json();
    const events = data.items || [];
    if(events.length === 0){ panel.innerHTML = '<div class="empty-note">Aucun événement à venir.</div>'; return; }
    panel.innerHTML = events.map(ev=>{
      const start = ev.start.dateTime || ev.start.date;
      const when = new Date(start).toLocaleString('fr-FR', { dateStyle:'medium', timeStyle: ev.start.dateTime ? 'short' : undefined });
      return '<div class="event-item"><div class="when">'+when+'</div><div>'+(ev.summary || '(Sans titre)')+'</div></div>';
    }).join('');
    const dashEl = document.getElementById('dashAgenda');
    if(dashEl) dashEl.innerHTML = events.slice(0,3).map(ev=>{
      const start = ev.start.dateTime || ev.start.date;
      const when = new Date(start).toLocaleString('fr-FR', { dateStyle:'medium', timeStyle: ev.start.dateTime ? 'short' : undefined });
      return '<div class="mini-event"><div class="when">'+when+'</div><div>'+(ev.summary || '(Sans titre)')+'</div></div>';
    }).join('');
  }catch(e){
    panel.innerHTML = '<div class="empty-note">Impossible de charger l\'agenda pour le moment.</div>';
  }
}

/* ---------- Boîte mail Gmail (OAuth2, lecture seule) ---------- */
document.getElementById('btnConnectMail').addEventListener('click', ()=>{
  if(!window.google || GOOGLE_CLIENT_ID.indexOf("COLLER_ICI") === 0){
    alert("La connexion à la boîte mail n'est pas encore configurée (identifiant Google manquant).");
    return;
  }
  const tokenClient = google.accounts.oauth2.initTokenClient({
    client_id: GOOGLE_CLIENT_ID,
    scope: 'https://www.googleapis.com/auth/gmail.readonly',
    callback: async (resp)=>{
      if(resp.error){ alert("Connexion refusée."); return; }
      saveGoogleToken('gmail', resp.access_token, resp.expires_in);
      await afficherMail(resp.access_token);
    }
  });
  tokenClient.requestAccessToken();
});

async function afficherMail(token){
  const panel = document.getElementById('mailPanel');
  panel.innerHTML = '<p class="hint">Chargement des messages...</p>';
  try{
    const listResp = await fetch('https://gmail.googleapis.com/gmail/v1/users/me/messages?maxResults=8', { headers:{ Authorization:'Bearer '+token } });
    const listData = await listResp.json();
    const ids = (listData.messages || []).map(m=> m.id);
    if(ids.length === 0){ panel.innerHTML = '<div class="empty-note">Aucun message récent.</div>'; return; }
    const messages = await Promise.all(ids.map(id=>
      fetch('https://gmail.googleapis.com/gmail/v1/users/me/messages/'+id+'?format=metadata&metadataHeaders=Subject&metadataHeaders=From', { headers:{ Authorization:'Bearer '+token } }).then(r=>r.json())
    ));
    panel.innerHTML = messages.map(m=>{
      const headers = (m.payload && m.payload.headers) || [];
      const from = (headers.find(h=>h.name==='From')||{}).value || '';
      const subject = (headers.find(h=>h.name==='Subject')||{}).value || '(Sans objet)';
      return '<div class="mail-item"><div class="from">'+from+'</div><div class="subject">'+subject+'</div><div class="snippet">'+(m.snippet||'')+'</div></div>';
    }).join('');
    const dashEl = document.getElementById('dashMail');
    if(dashEl) dashEl.innerHTML = messages.slice(0,3).map(m=>{
      const headers = (m.payload && m.payload.headers) || [];
      const from = (headers.find(h=>h.name==='From')||{}).value || '';
      const subject = (headers.find(h=>h.name==='Subject')||{}).value || '(Sans objet)';
      return '<div class="mini-mail"><div class="from">'+from+'</div><div>'+subject+'</div></div>';
    }).join('');
  }catch(e){
    panel.innerHTML = '<div class="empty-note">Impossible de charger la boîte mail pour le moment.</div>';
  }
}

// Si un jeton valide (non expiré) est encore en mémoire de session, on affiche directement
// l'agenda/le mail sans redemander la connexion — appelé une fois le CRM débloqué.
async function chargerSessionsGoogleEnCache(){
  const calToken = getValidGoogleToken('calendar');
  if(calToken) await afficherAgenda(calToken);
  const mailToken = getValidGoogleToken('gmail');
  if(mailToken) await afficherMail(mailToken);
}

