<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>CRM — Simplika</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400;1,6..72,500&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<script src="https://accounts.google.com/gsi/client" async defer></script>
<style>
  :root{
    --ink:#17242e; --ink-soft:#4b5a5c; --paper:#eef0ec; --card:#f8f9f6;
    --line:#d7dad2; --accent:#1f6f6b; --accent-soft:#e2ede9;
    --brass:#a6813c; --brass-soft:#f1e9d8;
    --warn:#9c4b3f; --warn-soft:#f3e2de;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  @media (prefers-reduced-motion: reduce){ *{animation-duration:.01ms !important; transition-duration:.01ms !important;} }
  body{font-family:'Inter',sans-serif; color:var(--ink); background:var(--paper); line-height:1.55; -webkit-font-smoothing:antialiased;}
  .eyebrow{font-family:'IBM Plex Mono',monospace; font-size:12px; letter-spacing:.12em; text-transform:uppercase; color:var(--accent);}
  h1,h2,h3{font-family:'Newsreader',serif; font-weight:500; letter-spacing:-0.01em;}
  a{color:inherit;}
  :focus-visible{outline:2px solid var(--accent); outline-offset:3px; border-radius:2px;}
  .wrap{max-width:1080px; margin:0 auto; padding:0 24px;}

  header{position:sticky; top:0; z-index:50; background:rgba(238,240,236,0.92); backdrop-filter:blur(6px); border-bottom:1px solid var(--line);}
  nav{display:flex; align-items:center; justify-content:space-between; padding:18px 24px; max-width:1080px; margin:0 auto;}
  .logo{font-family:'Newsreader',serif; font-size:20px; font-weight:500; text-decoration:none; color:inherit;}
  .logo span{color:var(--accent);}
  .logo small{display:block; font-family:'IBM Plex Mono',monospace; font-size:10.5px; letter-spacing:.1em; color:var(--ink-soft); text-transform:uppercase; margin-top:2px;}

  .hero{padding:44px 0 32px;}
  .hero h1{font-size:30px; line-height:1.18; margin:12px 0 10px;}
  .hero p{color:var(--ink-soft); font-size:15.5px; max-width:600px;}

  .btn{display:inline-flex; align-items:center; gap:8px; background:var(--ink); color:var(--paper); border:none; border-radius:3px; padding:11px 20px; font-size:14.5px; font-weight:500; cursor:pointer; transition:transform .15s ease, background .15s ease; white-space:nowrap;}
  .btn:hover{background:var(--accent); transform:translateY(-1px);}
  .btn:disabled{opacity:.5; cursor:not-allowed; transform:none;}
  .btn.outline{background:transparent; color:var(--ink); border:1px solid var(--line);}
  .btn.outline:hover{background:var(--card); color:var(--ink); transform:none;}
  .btn.danger{background:var(--warn-soft); color:var(--warn);}
  .btn.danger:hover{background:var(--warn); color:#fff;}
  .hint{font-size:12.5px; color:var(--ink-soft); margin-top:8px;}

  /* ACCÈS */
  #accessGate{background:var(--card); border:1px solid var(--line); border-radius:6px; padding:26px; margin-bottom:28px;}
  #accessGate h3{font-size:19px; margin-bottom:6px;}
  #accessGate .sub{color:var(--ink-soft); font-size:14px; margin-bottom:18px;}
  .field-row{display:flex; gap:14px; flex-wrap:wrap; align-items:flex-end;}
  .field{flex:1; min-width:160px;}
  .field label{display:block; font-size:12px; font-family:'IBM Plex Mono',monospace; letter-spacing:.04em; color:var(--ink-soft); margin-bottom:6px;}
  .field input, .field select, .field textarea{width:100%; background:#fff; border:1px solid var(--line); border-radius:3px; padding:10px 12px; font-family:'Inter',sans-serif; font-size:14.5px; color:var(--ink);}
  .field textarea{resize:vertical; min-height:70px;}
  .consent-row{display:flex; align-items:flex-start; gap:10px; margin-top:16px; font-size:13px; color:var(--ink-soft);}
  .consent-row input{margin-top:3px; flex-shrink:0;}
  .gate-msg{color:var(--warn); font-size:13.5px; margin-top:10px; display:none;}
  .status-banner{background:var(--accent-soft); color:var(--accent); border-radius:5px; padding:12px 16px; font-size:14px; margin-bottom:18px;}
  .gatedContent.locked{filter:blur(3px); opacity:.5; pointer-events:none; user-select:none;}

  /* TABS */
  .tabs{display:flex; gap:0; border-bottom:1px solid var(--line); margin-bottom:26px; flex-wrap:wrap;}
  .tab-btn{font-family:'IBM Plex Mono',monospace; font-size:12.5px; letter-spacing:.05em; text-transform:uppercase; background:none; border:none; padding:12px 18px 12px 0; margin-right:22px; color:var(--ink-soft); cursor:pointer; border-bottom:2px solid transparent;}
  .tab-btn.active{color:var(--ink); border-bottom-color:var(--accent);}
  .tab-panel{display:none;}
  .tab-panel.active{display:block;}

  /* CLIENTS */
  .panel{background:var(--card); border:1px solid var(--line); border-radius:6px; padding:22px; margin-bottom:22px;}
  .panel h3{font-size:17px; margin-bottom:14px;}
  .service-tags{display:flex; flex-wrap:wrap; gap:8px; margin-top:6px;}
  .service-check{display:flex; align-items:center; gap:6px; font-size:13px; background:#fff; border:1px solid var(--line); border-radius:20px; padding:5px 12px; cursor:pointer;}
  .service-check input{margin:0;}

  .client-card{background:#fff; border:1px solid var(--line); border-radius:6px; padding:16px 18px; margin-bottom:12px; cursor:pointer; transition:border-color .15s;}
  .client-card:hover{border-color:var(--accent);}
  .client-card .top{display:flex; justify-content:space-between; align-items:flex-start; gap:12px; flex-wrap:wrap;}
  .client-card h4{font-family:'Newsreader',serif; font-size:16.5px;}
  .client-card .co{font-size:13px; color:var(--ink-soft);}
  .client-card .badges{display:flex; flex-wrap:wrap; gap:6px; margin-top:8px;}
  .badge{font-family:'IBM Plex Mono',monospace; font-size:10.5px; letter-spacing:.04em; text-transform:uppercase; padding:3px 9px; border-radius:20px; background:var(--accent-soft); color:var(--accent);}
  .badge.etape{background:var(--brass-soft); color:var(--brass);}
  .empty-note{color:var(--ink-soft); font-size:14.5px; padding:24px; text-align:center; border:1px dashed var(--line); border-radius:6px;}

  /* SUIVI COMMERCIAL — kanban */
  .kanban{display:grid; grid-template-columns:repeat(5,1fr); gap:14px; overflow-x:auto;}
  @media (max-width:1000px){ .kanban{grid-template-columns:repeat(5, 220px);} }
  .kanban-col{background:var(--card); border:1px solid var(--line); border-radius:6px; padding:12px; min-width:200px;}
  .kanban-col h4{font-family:'IBM Plex Mono',monospace; font-size:11.5px; letter-spacing:.05em; text-transform:uppercase; color:var(--ink-soft); margin-bottom:10px;}
  .kanban-card{background:#fff; border:1px solid var(--line); border-radius:5px; padding:10px 12px; margin-bottom:8px; cursor:pointer; font-size:13px;}
  .kanban-card:hover{border-color:var(--accent);}
  .kanban-card .nom{font-weight:600;}
  .kanban-card .action{color:var(--brass); font-size:11.5px; margin-top:4px; font-family:'IBM Plex Mono',monospace;}

  /* MODALE ÉDITION CLIENT */
  #clientModalBg{display:none; position:fixed; inset:0; background:rgba(23,36,46,0.5); z-index:100; align-items:flex-start; justify-content:center; padding:40px 20px; overflow-y:auto;}
  #clientModalBg.show{display:flex;}
  #clientModal{background:#fff; border-radius:8px; padding:28px; max-width:560px; width:100%;}
  #clientModal h3{font-size:19px; margin-bottom:18px;}
  #clientModal .field-row{margin-bottom:14px;}
  #clientModal .actions{display:flex; justify-content:space-between; margin-top:20px; gap:10px; flex-wrap:wrap;}

  /* AGENDA / MAIL */
  .connect-box{text-align:center; padding:34px 20px;}
  .connect-box p{color:var(--ink-soft); font-size:14px; margin-bottom:16px; max-width:420px; margin-left:auto; margin-right:auto;}
  .event-item, .mail-item{background:#fff; border:1px solid var(--line); border-radius:5px; padding:12px 14px; margin-bottom:8px;}
  .event-item .when{font-family:'IBM Plex Mono',monospace; font-size:11.5px; color:var(--accent); margin-bottom:3px;}
  .mail-item .from{font-weight:600; font-size:13.5px;}
  .mail-item .subject{font-size:13.5px; margin-top:2px;}
  .mail-item .snippet{font-size:12.5px; color:var(--ink-soft); margin-top:3px;}

  footer{padding:30px 0; text-align:center; font-size:13px; color:var(--ink-soft);}

  /* TABLEAU DE BORD — mosaïque */
  .mosaic{display:grid; grid-template-columns:1fr 1fr; gap:16px;}
  @media (max-width:760px){ .mosaic{grid-template-columns:1fr;} }
  .tile{background:var(--card); border:1px solid var(--line); border-radius:8px; padding:20px; display:flex; flex-direction:column;}
  .tile.wide{grid-column:1 / -1;}
  .tile-head{display:flex; justify-content:space-between; align-items:center; margin-bottom:14px;}
  .tile-head h3{font-size:16px;}
  .tile-head a{font-family:'IBM Plex Mono',monospace; font-size:11px; letter-spacing:.04em; text-transform:uppercase; color:var(--accent); text-decoration:none;}
  .tile-empty{color:var(--ink-soft); font-size:13.5px; padding:14px 0;}
  .tile-mini-list{display:flex; flex-direction:column; gap:8px;}
  .mini-client{display:flex; justify-content:space-between; align-items:center; background:#fff; border:1px solid var(--line); border-radius:5px; padding:9px 12px; font-size:13px;}
  .mini-client .nom{font-weight:600;}
  .mini-client .co{color:var(--ink-soft); font-size:12px;}
  .mini-event, .mini-mail{background:#fff; border:1px solid var(--line); border-radius:5px; padding:9px 12px; font-size:13px; margin-bottom:6px;}
  .mini-event .when{font-family:'IBM Plex Mono',monospace; font-size:11px; color:var(--accent);}
  .mini-mail .from{font-weight:600; font-size:12.5px;}
  .stat-row{display:flex; gap:14px; flex-wrap:wrap;}
  .stat-box{flex:1; min-width:100px; background:#fff; border:1px solid var(--line); border-radius:6px; padding:14px; text-align:center;}
  .stat-box .n{font-family:'Newsreader',serif; font-size:28px; color:var(--accent);}
  .stat-box .lbl{font-size:11.5px; color:var(--ink-soft); text-transform:uppercase; letter-spacing:.04em; font-family:'IBM Plex Mono',monospace; margin-top:2px;}

  /* FICHE DÉCOUVERTE */
  .sync-note{background:var(--accent-soft); color:var(--accent); border-radius:5px; padding:10px 14px; font-size:13px; margin-bottom:16px;}
</style>
</head>
<body>

<header>
  <nav>
    <a href="simplika.html" class="logo">Simpl<span>ika</span><small>CRM</small></a>
  </nav>
</header>

<section class="hero">
  <div class="wrap">
    <span class="eyebrow">Service Simplika</span>
    <h1>Vos clients, vos rendez-vous, votre boîte mail — au même endroit.</h1>
    <p>Le CRM Simplika réunit le suivi de vos clients et des services qu'ils utilisent, votre pipeline commercial, votre agenda Google et votre boîte mail.</p>
  </div>
</section>

<div class="wrap">

  <div id="accessGate">
    <h3>Accès au CRM</h3>
    <p class="sub">Le CRM Simplika donne accès à l'ensemble des outils Simplika (audit compris) via un abonnement mensuel ou annuel. Les données de ton agenda et de ta boîte mail restent chez Google — le CRM ne fait que les afficher, avec ton autorisation.</p>
    <div id="authForm">
      <div class="field-row">
        <div class="field">
          <label for="authEmail">Email</label>
          <input id="authEmail" type="email" placeholder="ton@email.com">
        </div>
        <div class="field">
          <label for="authPassword">Mot de passe</label>
          <input id="authPassword" type="password" placeholder="••••••••">
        </div>
      </div>
      <div class="consent-row">
        <input type="checkbox" id="authConsent">
        <label for="authConsent">J'accepte que mes données soient collectées et utilisées par Simplika à des fins commerciales. (obligatoire pour créer un compte)</label>
      </div>
      <button class="btn" id="btnAuth" style="margin-top:16px;" disabled>Créer mon compte / me connecter</button>
      <p class="gate-msg" id="authError"></p>
    </div>

    <div id="statusBox" style="display:none;"></div>

    <div class="plan-cards" id="planCards" style="display:none;">
      <div class="plan-card">
        <h4>Mensuel</h4>
        <p>Accès à l'ensemble des outils Simplika, résiliable à tout moment.</p>
        <button class="btn" id="btnSubMensuel">S'abonner au mois</button>
      </div>
      <div class="plan-card">
        <h4>Annuel</h4>
        <p>Le même accès, engagement 12 mois — tarif préférentiel.</p>
        <button class="btn" id="btnSubAnnuel">S'abonner à l'année</button>
      </div>
    </div>

    <div style="text-align:center; margin-top:22px; padding-top:18px; border-top:1px solid var(--line);">
      <p class="hint" style="margin-bottom:10px;">Envie de montrer le CRM à un client potentiel avant de vous abonner ?</p>
      <button class="btn outline" id="btnSimulation">Voir une démonstration (données fictives)</button>
    </div>
  </div>

  <div id="simulationBanner" style="display:none;" class="status-banner" style="background:var(--brass-soft); color:var(--brass);">
    <strong>Mode démonstration</strong> — les données affichées sont fictives, rien n'est enregistré. <a href="#" id="linkQuitterSimulation" style="text-decoration:underline;">Quitter la démonstration</a>
  </div>

  <div id="crmApp" class="gatedContent locked">

    <div class="tabs">
      <button class="tab-btn active" data-tab="dashboard">Tableau de bord</button>
      <button class="tab-btn" data-tab="clients">Clients &amp; services</button>
      <button class="tab-btn" data-tab="suivi">Suivi commercial</button>
      <button class="tab-btn" data-tab="decouverte">Fiche découverte</button>
      <button class="tab-btn" data-tab="agenda">Agenda</button>
      <button class="tab-btn" data-tab="mail">Boîte mail</button>
    </div>

    <!-- TABLEAU DE BORD -->
    <div class="tab-panel active" id="tab-dashboard">
      <div class="mosaic">
        <div class="tile wide">
          <div class="tile-head"><h3>Suivi commercial en un coup d'œil</h3></div>
          <div class="stat-row" id="dashStats"></div>
        </div>
        <div class="tile">
          <div class="tile-head"><h3>Derniers clients enregistrés</h3><a href="#" data-goto="clients">Voir tout →</a></div>
          <div id="dashClients"></div>
        </div>
        <div class="tile">
          <div class="tile-head"><h3>Agenda</h3><a href="#" data-goto="agenda">Voir tout →</a></div>
          <div id="dashAgenda"></div>
        </div>
        <div class="tile wide">
          <div class="tile-head"><h3>Boîte mail</h3><a href="#" data-goto="mail">Voir tout →</a></div>
          <div id="dashMail"></div>
        </div>
      </div>
    </div>

    <!-- CLIENTS -->
    <div class="tab-panel" id="tab-clients">
      <div class="panel">
        <h3>Ajouter un client</h3>
        <div class="field-row">
          <div class="field"><label>Nom du contact</label><input id="c-nom" type="text" placeholder="Jean Dupont"></div>
          <div class="field"><label>Entreprise</label><input id="c-entreprise" type="text" placeholder="Dupont Rénovation"></div>
        </div>
        <div class="field-row" style="margin-top:12px;">
          <div class="field"><label>Email</label><input id="c-email" type="email" placeholder="jean@dupont-renovation.fr"></div>
          <div class="field"><label>Téléphone</label><input id="c-telephone" type="text" placeholder="06 00 00 00 00"></div>
        </div>
        <div style="margin-top:14px;">
          <label style="display:block; font-size:12px; font-family:'IBM Plex Mono',monospace; letter-spacing:.04em; color:var(--ink-soft); margin-bottom:6px;">Services souscrits</label>
          <div class="service-tags" id="c-services">
            <label class="service-check"><input type="checkbox" value="Calcul IK"> Calcul IK</label>
            <label class="service-check"><input type="checkbox" value="Découverte commerciale"> Découverte commerciale</label>
            <label class="service-check"><input type="checkbox" value="Autres facilitateurs"> Autres facilitateurs</label>
            <label class="service-check"><input type="checkbox" value="Audit entreprise"> Audit entreprise</label>
            <label class="service-check"><input type="checkbox" value="Sur mesure"> Sur mesure</label>
          </div>
        </div>
        <button class="btn" id="btnAddClient" style="margin-top:16px;">Ajouter ce client</button>
      </div>

      <div id="clientsList"></div>
    </div>

    <!-- SUIVI COMMERCIAL -->
    <div class="tab-panel" id="tab-suivi">
      <p class="hint" style="margin-bottom:16px;">Clique sur une fiche pour changer son étape, définir la prochaine action, ou ajouter une note.</p>
      <div class="kanban" id="kanbanBoard"></div>
    </div>

    <!-- FICHE DÉCOUVERTE -->
    <div class="tab-panel" id="tab-decouverte">
      <div class="panel">
        <h3>Fiche découverte</h3>
        <div class="sync-note">Cette fiche et la fiche client sont une seule et même donnée : la modifier ici met aussi à jour le client correspondant, et inversement.</div>
        <div class="field-row">
          <div class="field">
            <label>Client concerné</label>
            <select id="d-client-select"><option value="">— Nouveau contact —</option></select>
          </div>
        </div>
        <div class="field-row" style="margin-top:12px;">
          <div class="field"><label>Nom du contact</label><input id="d-nom" type="text" placeholder="Jean Dupont"></div>
          <div class="field"><label>Entreprise</label><input id="d-entreprise" type="text" placeholder="Dupont Rénovation"></div>
        </div>
        <div class="field-row" style="margin-top:12px;">
          <div class="field"><label>Email</label><input id="d-email" type="email" placeholder="jean@dupont-renovation.fr"></div>
          <div class="field"><label>Téléphone</label><input id="d-telephone" type="text" placeholder="06 00 00 00 00"></div>
        </div>
        <div class="field-row" style="margin-top:12px;">
          <div class="field"><label>Besoin exprimé</label><textarea id="d-besoin" placeholder="Ce que le contact recherche, tel qu'il l'a formulé..."></textarea></div>
        </div>
        <div class="field-row" style="margin-top:12px;">
          <div class="field"><label>Produits / services d'intérêt</label><input id="d-produits" type="text" placeholder="Ex : isolation combles, calcul IK..."></div>
          <div class="field"><label>Budget estimé</label><input id="d-budget" type="text" placeholder="Ex : 3 000 - 5 000 €"></div>
        </div>
        <button class="btn" id="btnSaveDecouverte" style="margin-top:16px;">Enregistrer la fiche découverte</button>
        <p class="hint" id="decouverteMsg" style="display:none;"></p>
      </div>
    </div>

    <!-- AGENDA -->
    <div class="tab-panel" id="tab-agenda">
      <div class="panel" id="agendaPanel">
        <div class="connect-box">
          <p>Connecte ton agenda Google pour voir tes prochains rendez-vous ici. Simplika ne fait qu'afficher tes événements — rien n'est modifié sur ton compte Google.</p>
          <button class="btn" id="btnConnectAgenda">Connecter mon agenda Google</button>
        </div>
      </div>
    </div>

    <!-- MAIL -->
    <div class="tab-panel" id="tab-mail">
      <div class="panel" id="mailPanel">
        <div class="connect-box">
          <p>Connecte ta boîte mail Gmail pour voir tes messages récents ici. Lecture seule — Simplika ne peut ni envoyer, ni supprimer, ni modifier tes emails.</p>
          <button class="btn" id="btnConnectMail">Connecter ma boîte mail Gmail</button>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- MODALE ÉDITION CLIENT -->
<div id="clientModalBg">
  <div id="clientModal">
    <h3>Modifier le client</h3>
    <div class="field-row"><div class="field"><label>Nom du contact</label><input id="m-nom" type="text"></div></div>
    <div class="field-row"><div class="field"><label>Entreprise</label><input id="m-entreprise" type="text"></div></div>
    <div class="field-row"><div class="field"><label>Email</label><input id="m-email" type="email"></div></div>
    <div class="field-row"><div class="field"><label>Téléphone</label><input id="m-telephone" type="text"></div></div>
    <div class="field-row">
      <div class="field">
        <label>Services souscrits</label>
        <div class="service-tags" id="m-services">
          <label class="service-check"><input type="checkbox" value="Calcul IK"> Calcul IK</label>
          <label class="service-check"><input type="checkbox" value="Découverte commerciale"> Découverte commerciale</label>
          <label class="service-check"><input type="checkbox" value="Autres facilitateurs"> Autres facilitateurs</label>
          <label class="service-check"><input type="checkbox" value="Audit entreprise"> Audit entreprise</label>
          <label class="service-check"><input type="checkbox" value="Sur mesure"> Sur mesure</label>
        </div>
      </div>
    </div>
    <div class="field-row">
      <div class="field">
        <label>Étape commerciale</label>
        <select id="m-etape">
          <option>Prospect</option>
          <option>Contacté</option>
          <option>Proposition envoyée</option>
          <option>Client actif</option>
          <option>Perdu</option>
        </select>
      </div>
    </div>
    <div class="field-row">
      <div class="field"><label>Prochaine action</label><input id="m-action" type="text" placeholder="Ex : relancer par téléphone"></div>
      <div class="field"><label>Date</label><input id="m-date-action" type="date"></div>
    </div>
    <div class="field-row">
      <div class="field"><label>Notes / historique</label><textarea id="m-notes" placeholder="Compte-rendu du dernier échange..."></textarea></div>
    </div>
    <div class="sync-note" style="margin-top:4px;">Fiche découverte (synchronisée avec l'onglet dédié)</div>
    <div class="field-row">
      <div class="field"><label>Besoin exprimé</label><textarea id="m-decouverte-besoin" placeholder="Ce que le contact recherche..."></textarea></div>
    </div>
    <div class="field-row">
      <div class="field"><label>Produits / services d'intérêt</label><input id="m-decouverte-produits" type="text" placeholder="Ex : isolation combles..."></div>
      <div class="field"><label>Budget estimé</label><input id="m-decouverte-budget" type="text" placeholder="Ex : 3 000 - 5 000 €"></div>
    </div>
    <div class="actions">
      <button class="btn danger" id="btnDeleteClient">Supprimer</button>
